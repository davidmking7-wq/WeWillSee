# secrets
.env

# python
.venv/
__pycache__/
*.pyc

# generated per-run artifacts (rebuilt by the CLI; calibration is
# engine-tagged and must be rebuilt after any signals change anyway)
scout/calibration.json
scout/last_scan.json
scout/final_picks.json
scout/backtest_cache.pkl
scout/earnings_cache.json
scout/backtest_cache_pit.pkl
scout/backtest_cache_1500.pkl
scout/form4_cache/
scout/sleeve_bars.pkl
# any lab's downloaded-data cache. The general glob matters: research agents
# invent new cache prefixes (cache_fundlab_*, cache_news_sent_*, ...) and a
# 200 MB pickle lands in a commit before anyone notices.
scout/cache_*
scout/cache_secbulk/
scout/cache_bars_master.pkl
scout/cache_deals_*.pkl
